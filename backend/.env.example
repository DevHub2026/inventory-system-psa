APP_NAME="PSA Region XII Inventory Management System"
APP_ENV=local
# Generate per environment with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack   
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_KEY=your_resend_api_key
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Local/dev fallback when a real provider is not configured:
# MAIL_MAILER=log
# MAIL_FROM_ADDRESS="inventory@example.test"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production checklist values:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://inventory.example.gov.ph
# LOG_LEVEL=warning
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=psa_inventory
# DB_USERNAME=psa_inventory_app
# DB_PASSWORD=change-me-outside-git
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=inventory.example.gov.ph
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids
# FILESYSTEM_DISK=public
# MAIL_MAILER=smtp
# SANCTUM_STATEFUL_DOMAINS=inventory.example.gov.ph
# CORS_ALLOWED_ORIGINS=https://inventory.example.gov.ph
