# PSA Inventory frontend local development config
#
# Keep API calls relative so Vite can proxy them to Laravel.
# This avoids CORS problems when testing from another device on the same LAN.
# When developing from other devices on the LAN set this to the backend host
# Example: http://192.168.110.230:8000/api/v1
VITE_API_BASE_URL=http://192.168.110.230:8000/api/v1

# Keep mock mode disabled for real backend testing.
VITE_USE_MOCK=false
