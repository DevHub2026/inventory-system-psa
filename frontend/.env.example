# Frontend env
# Leave unset in local development to call the backend via the Vite proxy.
# VITE_USE_MOCK=true
# VITE_API_BASE_URL=/api/v1

# LAN testing recommendation:
# Keep VITE_API_BASE_URL=/api/v1 when using the root runner.
# The Vite dev server proxies /api to the local Laravel backend, so phones on the same Wi-Fi can use:
#   http://YOUR_PC_IP:5173
#
# Only set a full backend URL if you intentionally want browser-to-backend direct calls:
# VITE_API_BASE_URL=http://YOUR_PC_IP:8000/api/v1

# Production build:
# VITE_USE_MOCK must be unset or false.
# Use /api/v1 when the frontend and Laravel API share the same HTTPS origin.
# Use the full HTTPS API URL only when the API is hosted on a separate origin and CORS is configured.
# VITE_API_BASE_URL=/api/v1
# VITE_API_BASE_URL=https://inventory.example.gov.ph/api/v1
